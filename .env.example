# Copy to .env and fill in the values after "=". NEVER commit .env.
# Find these in Supabase: Project Settings → API (or the Connect button).
# VITE_SUPABASE_URL looks like https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# The anon / publishable key (never the secret / service-role key)
VITE_SUPABASE_ANON_KEY=
